# Vanguard City — Environment Variables Template
# Copy this file to .env and fill in actual values
# NEVER commit .env to version control

# Database (Phase 4)
DATABASE_URL=postgresql+asyncpg://vanguard:password@localhost:5432/vanguard_city
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vanguard_city
POSTGRES_USER=vanguard
POSTGRES_PASSWORD=change_this_password

# JWT Authentication (Phase 19)
SECRET_KEY=change_this_to_a_secure_random_key_minimum_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://vanguard-city.vercel.app

# Gemini API (Phase 14 — RAG Civic Assistant)
GEMINI_API_KEY=your_gemini_api_key_here

# File Upload
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads

# Environment
ENVIRONMENT=development
DEBUG=true

# OpenStreetMap Nominatim Geocoding (NO API KEY REQUIRED)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=Vanguard/1.0 (contact: admin@vanguardcity.gov)
